# FILE: .env.example
# Copy to backend/.env for the API/worker, or use these values in your runtime
# environment. The defaults are local simulation; replace the provider values
# and credentials for live integrations.

# ---- App ----
APP_NAME=ReclaimAI
ENVIRONMENT=local                 # local | test | production
JWT_SECRET=dev-secret-change-me-please-32byte-minimum!!
NGROK_AUTHTOKEN=

# ---- Database ----
# Local (zero-infra): SQLite. Production: Postgres (psycopg).
DATABASE_URL=sqlite:///./reclaimai.db
# DATABASE_URL=postgresql+psycopg://reclaim:reclaim@db:5432/reclaimai

# ---- Providers (spec 13) ----
PAYMENT_PROVIDER=razorpay           # mock | razorpay
LLM_PROVIDER=groq                # rules | groq
NOTIFIER_PROVIDER=console         # console | smtp

# ---- Queue (spec 6) ----
QUEUE_PROVIDER=rabbitmq              # local | rabbitmq
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
QUEUE_NAME=reclaimai.recovery
DLQ_NAME=reclaimai.recovery.dlq
MAX_JOB_RETRIES=3

# ---- Razorpay ----
# Use test + rzp_test_* first. Use production + live keys only after validating
# the webhook and recovery behavior with a test merchant.
RAZORPAY_ENV=production
RAZORPAY_KEY_ID=key-here
RAZORPAY_KEY_SECRET=secret-here
RAZORPAY_WEBHOOK_SECRET=secret-here
RAZORPAY_MCP_URL=url-here
MOCK_PAYMENT_SUCCESS_RATE=0.5

# ---- LLM ----
GROQ_API_KEY=key-here
LLM_MODEL=llama-3.1-8b-instant

# ---- Determinism ----
RANDOM_SEED=1729
